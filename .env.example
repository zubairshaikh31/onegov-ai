# ─────────────────────────────────────────────────────────
# OneGov AI — Production Environment Variables Reference
# Copy to .env or .env.local and fill in production values.
# ─────────────────────────────────────────────────────────

# Database (PostgreSQL Async SQLAlchemy)
POSTGRES_USER=onegov
POSTGRES_PASSWORD=onegov_secret_pass_2026
POSTGRES_DB=onegov_ai
DATABASE_URL=postgresql+asyncpg://onegov:onegov_secret_pass_2026@postgres:5432/onegov_ai

# Redis Cache & Session Store
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=onegov_redis_pass_2026
REDIS_URL=redis://:onegov_redis_pass_2026@redis:6379/0

# JWT Security
JWT_SECRET_KEY=9a48b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth 2.0 (Identity Services GIS)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP Transactional Emails (Gmail / SendGrid / AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_NAME=OneGov AI
EMAIL_FROM_ADDRESS=noreply@onegov.ai

# Twilio SMS OTP Verification (India +91 format support)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXAAAAAAAAAAAAAAAA
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12025550142
